        </mxCell>
        <mxCell id="lp-title" value="&lt;b&gt;labprovider v2&lt;/b&gt;&lt;br&gt;single-node, non-HA, fully containerized (Docker Compose, control-plane-driven)" style="text;strokeColor=none;fillColor=none;rounded=0;whiteSpace=wrap;html=1;fontSize=16;verticalAlign=middle;align=center;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="1010" height="30" as="geometry" />
        </mxCell>
        <mxCell id="cp" value="&lt;b&gt;Control plane (web UI)&lt;/b&gt;&lt;br&gt;config wizard, live deploy (SSE), read-only dashboard, CSR signing; MSCA emulator (certsrv, optional).&lt;br&gt;Container: root + host network + docker socket + /opt/labprovider + /host/etc. Started by install.sh." style="rounded=0;fillColor=#ffe6cc;strokeColor=#d79b00;whiteSpace=wrap;html=1;fontSize=13;verticalAlign=middle;align=center;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="400" y="168" width="970" height="66" as="geometry" />
        </mxCell>
        <mxCell id="tfk" value="&lt;b&gt;Traefik ingress   :80 / :443&lt;/b&gt;&lt;br&gt;Terminates TLS with one step-ca  *.&lt;domain&gt;  wildcard leaf; routes by Host to bare FQDNs.&lt;br&gt;docker-label provider (shared &#x27;proxy&#x27; network) for stacks  +  file provider for control plane &amp; certsrv." style="rounded=0;fillColor=#e1d5e7;strokeColor=#9673a6;whiteSpace=wrap;html=1;fontSize=13;verticalAlign=middle;align=center;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="400" y="246" width="970" height="74" as="geometry" />
        </mxCell>
