        <mxCell id="note-ca" value="step-ca is the internal CA - CA_FQDN pinned to 127.0.0.1 so certificates issue before DNS / Traefik exist.&lt;br&gt;Traefik serves the shared *.&lt;domain&gt; wildcard; the control plane and certsrv keep their own leaf." style="text;strokeColor=none;fillColor=none;rounded=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fontColor=#b85450;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="415" y="688" width="940" height="34" as="geometry" />
        </mxCell>
        <mxCell id="note-msca" value="MSCA emulator flow:  VCF / SDDC Manager -&gt; https://certsrv.&lt;domain&gt;/certsrv (Basic Auth, via Traefik)&lt;br&gt;-&gt; control-plane SignCSR -&gt; step-ca, automating VCF certificate replacement via its Microsoft-CA integration." style="text;strokeColor=none;fillColor=none;rounded=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=center;fontColor=#333333;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="415" y="726" width="940" height="34" as="geometry" />
        </mxCell>
