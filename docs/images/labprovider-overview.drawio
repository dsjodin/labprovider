        <mxCell id="cons-note" value="Consumed at bare FQDNs on :443 through Traefik:&lt;br&gt;HTTPS UIs, OIDC / SCIM / LDAP identity,&lt;br&gt;PKI (step-ca + MSCA cert automation),&lt;br&gt;plus DNS, NTP, IPAM, S3, SFTP, SMB, syslog, mail." style="text;strokeColor=none;fillColor=none;rounded=0;whiteSpace=wrap;html=1;fontSize=11;verticalAlign=middle;align=left;fontColor=#333333;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="656" width="300" height="96" as="geometry" />
        </mxCell>
