# Generated secrets
# The variables marked "auto-generated" below are read by containers and never
# typed by a person. Leave one empty and labprovider generates it on the first
# deploy, stores it 0600 under /opt/labprovider/control-plane/secrets/<NAME>,
# and reuses that value on every deploy after - it is never rotated behind your
# back, because several of them are baked into a PostgreSQL data directory at
# initdb time. Set a value here instead and yours wins.

# Host and domain settings
# HOST_IP is the host address in CIDR notation; SEARCH_DOMAIN is the lab DNS zone.
HOST_IP="192.168.12.121/24"
SEARCH_DOMAIN="sddc.lab"

# Built-in service FQDNs. All resolve to HOST_IP; DNS records for them are
# generated automatically by the selected DNS backend (never add them to
# config/dns.seed). LABPROVIDER_FQDN is the
# canonical host identity and the reverse PTR target for HOST_IP.
LABPROVIDER_FQDN="labprovider.sddc.lab"
DNS_FQDN="dns.sddc.lab"
CA_FQDN="ca.sddc.lab"
DEPOT_FQDN="vcfdepot.sddc.lab"
KEYCLOAK_FQDN="auth.sddc.lab"
AUTHENTIK_FQDN="idp.sddc.lab"
ZITADEL_FQDN="zid.sddc.lab"
NETBOX_FQDN="netbox.sddc.lab"
S3_FQDN="s3.sddc.lab"
SFTP_FQDN="sftp.sddc.lab"
SYSLOG_FQDN="syslog.sddc.lab"
NTP_FQDN="ntp.sddc.lab"
MAILPIT_FQDN="mail.sddc.lab"
LLDAP_FQDN="ldap.sddc.lab"
SAMBA_FQDN="smb.sddc.lab"

# Internal networks allowed to query DNS and NTP
ALLOW_NET_1="10.0.0.0/8"
ALLOW_NET_2="172.16.0.0/12"
ALLOW_NET_3="192.168.0.0/16"

# Upstream DNS and NTP providers
# DNS_FORWARDER is the upstream resolver Technitium uses for external resolution.
# The Technitium deploy checks that it answers, not that it can reach the
# internet, so an internal resolver on an isolated lab is a valid setting.
DNS_FORWARDER="8.8.8.8"

CHRONY_SERVER_1="0.se.pool.ntp.org"
CHRONY_SERVER_2="1.se.pool.ntp.org"
CHRONY_SERVER_3="2.se.pool.ntp.org"

# Container images (pinned versions)
# This is the central place to control pinned image versions for containerized services.
# Update versions here without editing templates or bootstrap logic.
AUTHENTIK_IMAGE="ghcr.io/goauthentik/server:2026.5.3"
AUTHENTIK_POSTGRES_IMAGE="docker.io/library/postgres:16-alpine"
CA_IMAGE="docker.io/smallstep/step-ca:0.30.2"
# Dedicated postgres for step-ca ONLY (module independence; NOT shared).
CA_POSTGRES_IMAGE="docker.io/library/postgres:17-alpine"
DEPOT_IMAGE="docker.io/library/nginx:1.31-alpine"
KEYCLOAK_IMAGE="quay.io/keycloak/keycloak:26.6.3"
NETBOX_IMAGE="docker.io/netboxcommunity/netbox:v4.6.2"
NETBOX_POSTGRES_IMAGE="docker.io/library/postgres:17-alpine"
NETBOX_REDIS_IMAGE="docker.io/library/redis:7-alpine"
NETBOX_NGINX_IMAGE="docker.io/library/nginx:1.31-alpine"
S3_IMAGE="docker.io/chrislusf/seaweedfs:4.31"
SFTPGO_IMAGE="docker.io/drakkan/sftpgo:v2.7.3"
MAILPIT_IMAGE="docker.io/axllent/mailpit:v1.21.8"
LLDAP_IMAGE="docker.io/lldap/lldap:v0.6.3"
TECHNITIUM_IMAGE="docker.io/technitium/dns-server:15.3.0"
ZITADEL_IMAGE="ghcr.io/zitadel/zitadel:v4.16.1"
# Login V2 UI (decoupled container) and the TLS terminator that fronts both it
# and the core. The login image version should track ZITADEL_IMAGE.
ZITADEL_LOGIN_IMAGE="ghcr.io/zitadel/zitadel-login:v4.16.1"
ZITADEL_NGINX_IMAGE="docker.io/library/nginx:1.31-alpine"
ZITADEL_POSTGRES_IMAGE="docker.io/library/postgres:17-alpine"
# Locally built by the control plane deploy engine from embedded Dockerfiles
# (alpine + chrony / alpine + rsyslog); no registry access needed.
CHRONY_IMAGE="labprovider/chrony:0.1.0"
RSYSLOG_IMAGE="labprovider/rsyslog:0.1.0"
SAMBA_IMAGE="labprovider/samba:0.1.0"

# Keycloak bootstrap credentials. KEYCLOAK_PORT is published on 127.0.0.1 only
# (cleartext HTTP); reach Keycloak at https://${KEYCLOAK_FQDN} through Traefik.
KEYCLOAK_PORT="8443"
KEYCLOAK_ADMIN_USER="admin"
KEYCLOAK_ADMIN_PASSWORD="CHANGE_ME"
KEYCLOAK_BOOTSTRAP_REALM_NAME="labprovider"
KEYCLOAK_BOOTSTRAP_GROUP_NAME="vcf-admins"
KEYCLOAK_BOOTSTRAP_USERNAME="lab-admin"
KEYCLOAK_BOOTSTRAP_USER_PASSWORD="CHANGE_ME"
KEYCLOAK_BOOTSTRAP_USER_EMAIL_DOMAIN="sddc.lab"
KEYCLOAK_BOOTSTRAP_CLIENT_ID="vcf-sso"
KEYCLOAK_BOOTSTRAP_CLIENT_SECRET="CHANGE_ME"
# Comma-separated HTTPS redirect URIs for the bootstrap OIDC client. Do not include spaces between entries.
KEYCLOAK_BOOTSTRAP_CLIENT_REDIRECT_URIS="https://pod-240-vc01.sddc.lab/federation/t/CUSTOMER/auth/response/oauth2"

# Authentik identity provider (OIDC + outbound SCIM 2.0). AUTHENTIK_PORT is
# published on 127.0.0.1 only (cleartext HTTP); use https://${AUTHENTIK_FQDN}.
AUTHENTIK_PORT="9443"
AUTHENTIK_ADMIN_PASSWORD="CHANGE_ME"
AUTHENTIK_API_TOKEN="CHANGE_ME"
# At least 50 characters; the generated one is 64.
AUTHENTIK_SECRET_KEY=""   # auto-generated when empty
AUTHENTIK_PG_DB="authentik"
AUTHENTIK_PG_USER="authentik"
AUTHENTIK_PG_PASSWORD=""   # auto-generated when empty
AUTHENTIK_BOOTSTRAP_CLIENT_ID="vcf-sso"
AUTHENTIK_BOOTSTRAP_CLIENT_SECRET="CHANGE_ME"
AUTHENTIK_BOOTSTRAP_GROUP_NAME="vcf-admins"
AUTHENTIK_BOOTSTRAP_USERNAME="lab-admin"
AUTHENTIK_BOOTSTRAP_USER_PASSWORD="CHANGE_ME"
AUTHENTIK_BOOTSTRAP_USER_EMAIL_DOMAIN="sddc.lab"
# Comma-separated HTTPS redirect URIs for the bootstrap OIDC client. Do not include spaces between entries.
AUTHENTIK_BOOTSTRAP_CLIENT_REDIRECT_URIS="https://pod-240-vc01.sddc.lab/federation/t/CUSTOMER/auth/response/oauth2"

# Zitadel identity provider (OIDC)
ZITADEL_PORT="7443"
ZITADEL_ADMIN_USERNAME="zitadel-admin"
ZITADEL_ADMIN_PASSWORD="CHANGE_ME"
# Exactly 32 characters, which is what the generated one is.
ZITADEL_MASTERKEY=""   # auto-generated when empty
ZITADEL_PG_DB="zitadel"
ZITADEL_PG_USER="zitadel"
ZITADEL_PG_PASSWORD=""   # auto-generated when empty
# Zitadel generates the OIDC client id/secret on creation; the deploy writes the
# real values to <ZITADEL_DIR>/certs/<ZITADEL_FQDN>/zitadel-oidc-client.txt.
ZITADEL_BOOTSTRAP_CLIENT_ID="vcf-sso"
ZITADEL_BOOTSTRAP_CLIENT_SECRET="CHANGE_ME"
ZITADEL_BOOTSTRAP_GROUP_NAME="vcf-admins"
ZITADEL_BOOTSTRAP_USERNAME="lab-admin"
ZITADEL_BOOTSTRAP_USER_PASSWORD="CHANGE_ME"
ZITADEL_BOOTSTRAP_USER_EMAIL_DOMAIN="sddc.lab"
# Comma-separated HTTPS redirect URIs for the bootstrap OIDC client. Do not include spaces between entries.
ZITADEL_BOOTSTRAP_CLIENT_REDIRECT_URIS="https://pod-240-vc01.sddc.lab/federation/t/CUSTOMER/auth/response/oauth2"
# Optional comma-separated tenant organization names. When set, each name becomes
# an isolated Zitadel org with its own vcf-sso project, OIDC client, role, and
# lab user; the generated client id/secret and org login scope are written to
# <ZITADEL_DIR>/certs/<ZITADEL_FQDN>/zitadel-oidc-<name>.txt. Empty keeps a single
# set in the default org. All tenants currently share the bootstrap client/user
# template above (redirect URIs included). Example: ZITADEL_TENANTS="customer-a,customer-b"
ZITADEL_TENANTS=""

# NetBox source of truth. NETBOX_PORT is published on 127.0.0.1 only (cleartext
# HTTP); use https://${NETBOX_FQDN} through Traefik.
NETBOX_PORT="8444"
NETBOX_POSTGRES_DB="netbox"
NETBOX_POSTGRES_USER="netbox"
NETBOX_POSTGRES_PASSWORD=""   # auto-generated when empty
NETBOX_REDIS_PASSWORD=""   # auto-generated when empty
# At least 50 characters; the generated one is 64.
NETBOX_SECRET_KEY=""   # auto-generated when empty
# Optional. NetBox 4.6 requires an API token pepper (>= 50 chars) to hash v2 API
# tokens. Leave unset to generate and persist one automatically under
# NETBOX_DIR/secrets. Do not change it once tokens exist: changing the pepper
# invalidates every existing API token, including the dns-sync token.
# NETBOX_API_TOKEN_PEPPER=""
NETBOX_ALLOWED_HOSTS="netbox.sddc.lab"
NETBOX_CSRF_TRUSTED_ORIGINS="https://netbox.sddc.lab"
NETBOX_SUPERUSER_NAME="admin"
NETBOX_SUPERUSER_EMAIL="admin@sddc.lab"
NETBOX_SUPERUSER_PASSWORD="CHANGE_ME"

# S3-compatible object storage
S3_PORT="8333"
S3_ACCESS_KEY="CHANGE_ME"
S3_SECRET_KEY="CHANGE_ME"

# VCF offline depot. Traefik fronts it at https://${DEPOT_FQDN}; DEPOT_HTTP_PORT
# is the loopback readiness port (must not be 80/443, which Traefik owns).
DEPOT_HTTP_PORT="8088"
DEPOT_BASIC_AUTH_USER="depot"
DEPOT_BASIC_AUTH_PASSWORD="CHANGE_ME"

# SFTPGo service
# SFTP_PORT carries SSH and stays reachable; SFTP_ADMIN_PORT is the cleartext
# admin UI, published on 127.0.0.1 only (use https://${SFTP_FQDN}).
SFTP_PORT="2022"
SFTP_ADMIN_PORT="8080"
SFTP_ADMIN_USER="admin"
SFTP_ADMIN_PASSWORD="CHANGE_ME"
# Optional. Set all three values to bootstrap one SFTPGo backup user if it does not already exist.
# SFTP_BACKUP_USERNAME="backup"
# SFTP_BACKUP_PASSWORD="CHANGE_ME"
# SFTP_BACKUP_HOME_DIR="/opt/labprovider/sftpgo/data/backup"

# Mailpit SMTP sink. Traefik fronts the web UI at https://${MAILPIT_FQDN};
# MAILPIT_UI_PORT is the loopback readiness port (must not be 80/443). Point lab
# service SMTP (vCenter, SDDC Manager, Aria) at HOST_IP:MAILPIT_SMTP_PORT.
MAILPIT_SMTP_PORT="1025"
MAILPIT_UI_PORT="8025"

# LLDAP directory. LDAP (LLDAP_LDAP_PORT) and LDAPS (LLDAP_LDAPS_PORT, terminated
# with a step-ca leaf) are published for appliance binds; Traefik fronts the
# admin UI at https://${LLDAP_FQDN} (LLDAP_UI_PORT is the loopback readiness port).
LLDAP_LDAP_PORT="3890"
LLDAP_LDAPS_PORT="6360"
LLDAP_UI_PORT="17170"
LLDAP_BASE_DN="dc=sddc,dc=lab"
LLDAP_ADMIN_USER="admin"
LLDAP_ADMIN_PASSWORD="CHANGE_ME"
# Signs session tokens; changing it invalidates active sessions.
LLDAP_JWT_SECRET=""   # auto-generated when empty
# Derives the server private key; keep it stable once set.
LLDAP_KEY_SEED=""   # auto-generated when empty
# vCenter/VCF seed. On deploy the control plane pre-provisions two groups
# (vsphere-admins, vsphere-readonly) plus a read-only bind service account and
# an admin test user, so a vCenter OpenLDAP identity source works out of the box:
#   users base DN   ou=people,${LLDAP_BASE_DN}
#   groups base DN  ou=groups,${LLDAP_BASE_DN}
#   bind DN         uid=${LLDAP_VCENTER_BIND_USER},ou=people,${LLDAP_BASE_DN}
#   login attribute uid    membership attribute member
LLDAP_VCENTER_BIND_USER="svc-vcenter"
LLDAP_VCENTER_BIND_PASSWORD="CHANGE_ME"
LLDAP_VCENTER_ADMIN_USER="vcenter-admin"
LLDAP_VCENTER_ADMIN_PASSWORD="CHANGE_ME"

# PyKMIP key server for the VCF encryption workflows (vSAN encryption, VM
# encryption). The image is built locally from a pinned pykmip release, like
# chrony and rsyslog. KMIP is TLS with client-certificate auth on its own port,
# not HTTP, so Traefik does not front it: vCenter connects to KMIP_PORT
# directly. KMIP_DATA_DIR holds the keys that decrypt your encrypted VMs -
# back it up, and note that removing the service preserves it.
KMIP_IMAGE="labprovider/kmip:0.1.0"
KMIP_PYKMIP_VERSION="0.10.0"
KMIP_FQDN="kmip.sddc.lab"
KMIP_PORT="5696"
KMIP_DIR="/opt/labprovider/kmip"
KMIP_DATA_DIR="/opt/labprovider/kmip/data"

# Harbor container registry, for the VKS and vSphere image-pull workflows
# (projects, robot accounts, image-pull secrets, replication). This is the
# heaviest service here - eight containers, its own PostgreSQL and Redis - and
# the only one whose compose file labprovider does not write: goharbor/prepare
# generates it from a rendered harbor.yml. HARBOR_VERSION must match the tag on
# HARBOR_PREPARE_IMAGE, because prepare validates one against the other.
#
# Reached at https://${HARBOR_FQDN} through Traefik. HARBOR_HTTP_PORT is the
# cleartext backend, published on 127.0.0.1 only. HARBOR_DATA_DIR holds the
# pushed images and the account database, and is preserved when the service is
# removed. HARBOR_DB_PASSWORD is generated when left empty.
#
# docker login ${HARBOR_FQDN} and VKS image pulls require the step-ca root in
# the client's trust store; download it from the dashboard's Access panel.
# HARBOR_TRIVY_ENABLE adds the vulnerability scanner, which downloads a large
# database on first start - off by default.
HARBOR_FQDN="harbor.sddc.lab"
HARBOR_VERSION="2.13.0"
HARBOR_PREPARE_IMAGE="docker.io/goharbor/prepare:v2.13.0"
HARBOR_HTTP_PORT="8086"
HARBOR_DATA_DIR="/opt/labprovider/harbor"
HARBOR_ADMIN_PASSWORD="CHANGE_ME"
HARBOR_DB_PASSWORD=""
HARBOR_TRIVY_ENABLE="false"

# Samba SMB/CIFS share. Raw TCP on SAMBA_PORT (445); one share (SAMBA_SHARE_NAME)
# backed by SAMBA_SHARE_DIR, accessible by SAMBA_USER. Image built locally.
# SAMBA_FQDN (defined above) is published in DNS as an A record to the host, so
# clients can reach //${SAMBA_FQDN}/${SAMBA_SHARE_NAME} instead of the bare IP.
SAMBA_PORT="445"
SAMBA_SHARE_NAME="labshare"
SAMBA_USER="labuser"
SAMBA_PASSWORD="CHANGE_ME"

# Technitium DNS service
# Web console (HTTP) and TLS console/API ports. DNS itself is fixed on 53/tcp+udp.
# TECHNITIUM_HTTP_PORT is cleartext and published on 127.0.0.1 only; remote
# access goes to TECHNITIUM_HTTPS_PORT or https://${DNS_FQDN} through Traefik.
# DHCP_ENABLE="true" changes that - see the DHCP block below.
TECHNITIUM_HTTP_PORT="5380"
TECHNITIUM_HTTPS_PORT="53443"
# The control plane rotates the first-boot admin/admin credentials to this
# value on first deploy and authenticates with it on re-runs.
TECHNITIUM_ADMIN_PASSWORD="CHANGE_ME"

# DHCP, served by the same Technitium container - no second service. Leases
# register themselves in the lab zone, and clients are handed Technitium as
# their resolver, so this stays consistent with NetBox as the source of truth.
#
# READ BEFORE ENABLING: DHCP only works on the host network. A DHCPDISCOVER is
# a broadcast to 255.255.255.255:67 and docker's published-port proxy does not
# deliver it. Setting DHCP_ENABLE="true" therefore moves the Technitium
# container to network_mode: host, which means its cleartext admin console
# (TECHNITIUM_HTTP_PORT) binds the host address instead of 127.0.0.1 only.
# Traefik keeps fronting https://${DNS_FQDN} through its file provider, the
# same wiring the control plane uses. That exposure is the cost of DHCP; leave
# this false unless you need it, and redeploy technitium AND traefik after
# changing it.
DHCP_ENABLE="false"
# Only read when DHCP_ENABLE is true; the values below still have to parse, so
# leave the defaults in place rather than blanking them. The range must run
# forwards and sit inside the DHCP_ROUTER subnet - both are checked before the
# deploy touches Technitium. Clients get ${SEARCH_DOMAIN} as their domain and
# ${DNS_FQDN} as their DNS server automatically.
DHCP_SCOPE_NAME="lab"
DHCP_RANGE_START="192.168.12.150"
DHCP_RANGE_END="192.168.12.199"
DHCP_SUBNET_MASK="255.255.255.0"
DHCP_ROUTER="192.168.12.1"
DHCP_LEASE_DAYS="1"
# dns-sync (NetBox -> Technitium reconcile)
# Locally built image tag (Dockerfile under services/dns-sync). Bootstrap
# builds this tag, then compose runs it - no registry push needed.
DNS_SYNC_IMAGE="labprovider/dns-sync:0.1.0"
# HTTPS endpoints dns-sync reads from / writes to; the FQDNs are pinned to
# 127.0.0.1 during bootstrap (single-node design).
DNS_SYNC_NETBOX_URL="https://netbox.sddc.lab"
DNS_SYNC_TECHNITIUM_URL="https://dns.sddc.lab"
# Reconcile interval, e.g. 30s, 5m, or 1h.
DNS_SYNC_INTERVAL="30s"
# Non-admin Technitium user the read-only dashboard authenticates as (auto-created
# by --technitium). dns-sync grants it View on each newly created zone so
# continuously-synced zones appear in the dashboard without a --technitium re-run.
# Best-effort; leave empty to disable the grant.
DNS_SYNC_TECHNITIUM_DASHBOARD_USER="dashboard"

# rsyslog collector
SYSLOG_PORT="514"

# labprovider control plane (services/control-plane) - currently the read-only
# "current state" dashboard. Deploy with `--dashboard` (also included in
# `--all`, last), or run it manually with services/control-plane/scripts/run.sh.
# See services/control-plane/README.md.
# Locally built image tag (Dockerfile under services/control-plane); compose
# builds it. The scoped read-only tokens under CONTROL_PLANE_SECRETS_DIR are
# auto-provisioned by --netbox and --technitium; until the producing module has
# run the NetBox and Technitium panels degrade to "not configured" rather than
# failing.
# INSTALLER-OWNED: install.sh sets the image tag and the listen address when it
# starts the container (CONTROL_PLANE_IMAGE / CONTROL_PLANE_PORT in the script).
# The values here are documentation and the Traefik router's fallback; editing
# them in the wizard does not move the running control plane. Change them in
# install.sh and re-run it.
CONTROL_PLANE_IMAGE="labprovider/control-plane:0.1.0"
CONTROL_PLANE_ADDR=":8445"
CONTROL_PLANE_FQDN="dashboard.sddc.lab"
# Where the issued leaf cert (control-plane.crt/.key) lives, and the CA root
# the control plane trusts when calling NetBox/Technitium over TLS.
CONTROL_PLANE_CERT_DIR="/opt/labprovider/control-plane/certs"
# Read-only scoped tokens the control plane reads. Auto-provisioned at deploy
# time (--netbox and --technitium write them here when CONTROL_PLANE_SECRETS_DIR
# is set); an operator-placed SOPS/age token in the same path wins and is never
# overwritten:
#   technitium.token          - a scoped Technitium API token (not the admin one)
#   netbox-readonly.token     - a DEDICATED minimum-read-scope NetBox token,
#                               NOT the dns-sync or bootstrap admin token
# Also holds one file per generated secret, named after the variable (see
# "Generated secrets" at the top of this file).
CONTROL_PLANE_SECRETS_DIR="/opt/labprovider/control-plane/secrets"
# Days-to-expiry threshold below which a certificate is flagged as expiring.
CONTROL_PLANE_CERT_WARN_DAYS="30"
# HTTPS endpoints the control plane reads (pinned to 127.0.0.1 via extra_hosts,
# single-node design).
CONTROL_PLANE_NETBOX_URL="https://netbox.sddc.lab"
CONTROL_PLANE_TECHNITIUM_URL="https://dns.sddc.lab"
# Host docker group id, so the read-only socket mount is usable by uid 1000.
# Find it with: getent group docker | cut -d: -f3
CONTROL_PLANE_DOCKER_GID="999"
# Comma-separated container name substrings shown in the Services panel.
CONTROL_PLANE_CONTAINER_FILTERS="step-ca,technitium,netbox,dns-sync,authentik,keycloak,zitadel,depot,sftpgo,s3,traefik,chrony,rsyslog,mailpit,lldap,samba,kmip,harbor,control-plane"
# Log lines tailed per container for the Recent errors panel.
CONTROL_PLANE_LOG_TAIL="200"
# Per-upstream request timeout; one slow source never hangs the page.
CONTROL_PLANE_UPSTREAM_TIMEOUT="5s"

# step-ca service
CA_PORT="9000"
CA_NAME="labprovider CA"
CA_PROVISIONER_NAME="admin"
SERVICE_CERT_DURATION="8760h"
# Default managed step-ca password file location. Keep this under CA_DATA_DIR.
# labprovider uses this file as-is when it already exists.
# Otherwise labprovider materializes CA_PASSWORD here or generates one automatically.
CA_PASSWORD_FILE="/opt/labprovider/step-ca/secrets/password.txt"
# Optional. labprovider writes this value to the managed password file with mode 0600 when set.
# CA_PASSWORD=""
CA_ENABLE_ACME="true"

# step-ca PostgreSQL backend (dedicated postgres, NOT shared with any other
# service). step-ca uses postgres as an opaque key-value store; switching to it
# is a CA rebuild - badger data does not migrate. The owner-role password is
# supplied to step-ca via a mounted .pgpass file (PGPASSFILE), never inlined in
# ca.json's dataSource. Mirrors the NETBOX_POSTGRES_* variables.
CA_POSTGRES_DB="stepca"
CA_POSTGRES_USER="stepca"
CA_POSTGRES_PASSWORD=""   # auto-generated when empty
# Loopback-published port for the CA postgres so the host-networked dashboard
# can read the cert tables at 127.0.0.1. Never exposed off-host.
CA_POSTGRES_PORT="5432"
# Read-only role the dashboard cert panel uses: SELECT on the cert tables only.
# Must differ from CA_POSTGRES_USER.
CA_POSTGRES_RO_USER="dashboard_ro"
CA_POSTGRES_RO_PASSWORD=""   # auto-generated when empty

# Microsoft-CA web-enrollment emulator (VCF certificate automation).
# Serves an ADCS "certsrv" surface in front of step-ca so VCF / SDDC Manager can
# enroll certificates via its Microsoft CA integration. When enabled, the control
# plane binds a second plain-HTTP listener on VMSCA_PORT (host networking); Traefik
# terminates TLS and fronts it. Point SDDC Manager's Certificate Authority at
# https://${VMSCA_FQDN}/certsrv (no port) with CA Type "Microsoft",
# these Basic Auth credentials, and Template Name = VMSCA_TEMPLATE.
VMSCA_ENABLE="false"
# Dedicated name for the certsrv surface. Resolves to HOST_IPV4 like every other
# service FQDN (added to DNS only when VMSCA_ENABLE is true); Traefik fronts the
# emulator's plain-HTTP listener at https://${VMSCA_FQDN} (no port).
VMSCA_FQDN="certsrv.sddc.lab"
# Must not collide with any other service port (NETBOX_PORT is 8444,
# CONTROL_PLANE_ADDR is 8445, KEYCLOAK_PORT is 8443).
VMSCA_PORT="8446"
VMSCA_USERNAME="vcf-enroll"
VMSCA_PASSWORD="CHANGE_ME"
VMSCA_TEMPLATE="VMware"

# Traefik reverse proxy (single ingress on :80/:443).
# When enabled, Traefik terminates TLS with one step-ca-issued *.<SEARCH_DOMAIN>
# wildcard leaf and routes each service by its bare FQDN, so operators reach
# services at https://<service>.<domain> with no port. Bridge service stacks are
# discovered via docker labels on a shared "proxy" network (created by
# install.sh); the host-networked control plane and certsrv are wired via
# Traefik's file provider. Non-HTTP services (DNS 53, NTP 123, syslog 514, SFTP
# 2022) and step-ca (9000) stay on their own ports. Lab posture: Traefik talks
# plain HTTP to backends over the proxy network. Traefik is mandatory: every
# service template carries its labels and only Traefik terminates TLS.
TRAEFIK_IMAGE="docker.io/library/traefik:v3.7.7"
TRAEFIK_FQDN="traefik.sddc.lab"
TRAEFIK_DIR="/opt/labprovider/traefik"
# Basic-auth credentials for the Traefik dashboard at https://${TRAEFIK_FQDN}.
TRAEFIK_DASHBOARD_USER="admin"
TRAEFIK_DASHBOARD_PASSWORD="CHANGE_ME"

# Output and deployment paths
# Working directory for rendered runtime files (separate from persistent data and repo location)
WORKDIR="/opt/labprovider/runtime"
CA_DATA_DIR="/opt/labprovider/step-ca"
# CA postgres data. MUST be a sibling of CA_DATA_DIR, never nested under it:
# do_ca runs `chown -R 1000:1000 CA_DATA_DIR`, which would corrupt postgres
# data (uid 70) on every redeploy if it lived inside CA_DATA_DIR.
CA_POSTGRES_DATA_DIR="/opt/labprovider/stepca-postgres"
DEPOT_DIR="/opt/labprovider/depot"
DEPOT_DATA_DIR="/opt/labprovider/depot/data"
DEPOT_AUTH_DIR="/opt/labprovider/depot/auth"
KEYCLOAK_DIR="/opt/labprovider/keycloak"
AUTHENTIK_DIR="/opt/labprovider/authentik"
ZITADEL_DIR="/opt/labprovider/zitadel"
NETBOX_DIR="/opt/labprovider/netbox"
NETBOX_MEDIA_DIR="/opt/labprovider/netbox/media"
NETBOX_POSTGRES_DATA_DIR="/opt/labprovider/netbox/postgres"
NETBOX_REDIS_DATA_DIR="/opt/labprovider/netbox/redis"
S3_DATA_DIR="/opt/labprovider/seaweedfs"
SFTP_DATA_DIR="/opt/labprovider/sftpgo/data"
SFTP_HOME_DIR="/opt/labprovider/sftpgo/home"
MAILPIT_DATA_DIR="/opt/labprovider/mailpit"
LLDAP_DATA_DIR="/opt/labprovider/lldap/data"
LLDAP_CERT_DIR="/opt/labprovider/lldap/certs"
SAMBA_SHARE_DIR="/opt/labprovider/samba/labshare"
# Under /opt/labprovider so the containerized rsyslog and the control plane
# share the mount (previous default was /var/log/labprovider).
SYSLOG_LOG_DIR="/opt/labprovider/syslog/logs"
# Drift-file data for the containerized chrony.
CHRONY_DIR="/opt/labprovider/chrony"
TECHNITIUM_DATA_DIR="/opt/labprovider/technitium/data"
TECHNITIUM_CERT_DIR="/opt/labprovider/technitium/certs"
DNS_SYNC_DIR="/opt/labprovider/dns-sync"
# Where the dns-sync API tokens live. netbox.token is auto-provisioned by
# --netbox and technitium.token by --technitium; placing decrypted tokens
# here out of band (SOPS/age) is the operator override and wins while valid.
# --dns-sync fails if either token file is missing.
DNS_SYNC_SECRETS_DIR="/opt/labprovider/dns-sync/secrets"
